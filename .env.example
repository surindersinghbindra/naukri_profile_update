# =============================================================
# Naukri.com Profile Refresh Automation — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =============================================================

# ── Naukri.com Credentials (REQUIRED) ──────────────────────
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password_here

# ── Resume Settings ────────────────────────────────────────
# Enable/disable resume upload (true/false)
# Set to false to run in Safe Profile-Toggling Mode (no file upload risk)
ENABLE_RESUME_UPLOAD=true

# Path to your resume file INSIDE the container (mapped via volume)
RESUME_PATH=/app/resumes/resume.pdf

# ── Profile Update Strategy ────────────────────────────────
# Your target role — used for headline rotation keywords
TARGET_ROLE=Senior Software Engineer

# Enable/disable headline rotation (true/false)
# Set to false OR leave HEADLINES blank to skip headline updates
ENABLE_HEADLINE_ROTATION=true

# Comma-separated list of headline variations to rotate through
# The script will pick one each run. Include strong keywords!
# Leave BLANK to skip headline rotation entirely.
HEADLINES=Senior Software Engineer | Python | AWS | Microservices,Full Stack Developer | Python | React | Cloud Native,Backend Engineer | Python | Django | REST APIs | AWS,Software Engineer | Distributed Systems | Python | Docker | K8s

# Enable/disable key skills toggle (true/false)
# Set to false OR leave KEY_SKILLS blank to skip skills updates
ENABLE_SKILLS_UPDATE=true

# Comma-separated key skills to rotate/reorder
# Leave BLANK to skip skills update entirely.
KEY_SKILLS=Python,Django,Flask,FastAPI,React,JavaScript,TypeScript,AWS,Docker,Kubernetes,PostgreSQL,Redis,CI/CD,Microservices,REST APIs,GraphQL,Git

# ── Schedule ───────────────────────────────────────────────
# Cron expression for update schedule (default: 8:00 AM IST daily)
CRON_SCHEDULE=0 8 * * *

# ── Telegram Notifications (OPTIONAL) ─────────────────────
# Create a bot via @BotFather on Telegram and get the token
# Get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── PostgreSQL Database & Analytics ─────────────────────────
ENABLE_DB_STORAGE=true
POSTGRES_DB=naukri_analytics
POSTGRES_USER=naukri_user
POSTGRES_PASSWORD=naukri_secure_password_123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Advanced Settings ──────────────────────────────────────
# Headless browser mode (true for Docker, false for local debugging)
HEADLESS=true

# Human-like delay range in seconds (min,max) to mimic real user behavior
HUMAN_DELAY_RANGE=2,5

# Max retry attempts on failure
MAX_RETRIES=3

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

