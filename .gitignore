# Naukri Profile Update Automation — .gitignore

# Credentials & Environment Files
.env
profiles/*/.env

# Resume PDF Files (Gitignored for privacy)
resumes/*.pdf
profiles/*/resumes/*.pdf
*.pdf

# Logs, Database & Screenshots
logs/
logs/*
profiles/*/logs/
*.log
*.png
*.db
postgres_data/

# Session Data & Cookies
session_storage/
profiles/*/session_storage/
*.json
!package.json

# Python Virtual Environment & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
